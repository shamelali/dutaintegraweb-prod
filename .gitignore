# dependencies
/node_modules
# The repo is npm-only (package-lock.json). A stray `pnpm install` writes an
# empty pnpm-lock.yaml at the root; ignore it so it never lands in a commit.
pnpm-lock.yaml

# local env (keep the example)
.env*
!.env.example
/.dev.vars
/env
/env.*

# Python bytecode cache
__pycache__/

# runtime data — JSONL fallback stores. The README is tracked; its
# contents never are.
/data/*
!/data/README.md

# logs & debug
*.log
npm-debug.log*

# misc
.DS_Store
*.pem
# FUSE leaves these behind when a running dev server still holds a replaced
# build artifact, and `git add Web/` would sweep one into a commit.
.fuse_hidden*

# prevent git bundles from being committed
*.bundle
.vercel

# redundant backups (git has full history)
Web-backup-*/

# binary docs
*.docx

# personal tool configs
obsidian-knowledge-base/
# CLI-local permissions/rules. `.qoder/settings.json` is the shareable project
# scope and stays committable; the .local file carries this machine's approvals.
.qoder/settings.local.json
# Session transcripts and workflow run artifacts: full prompts, file excerpts
# and tool output, per machine.
.qoder/sessions/

# next.js build output
.next/
next-env.d.ts
tsconfig.tsbuildinfo

# Phase 4 QA zip + extracted snapshot (not for commit)
dutaintegraweb-phase4-unified.zip
dutaintegraweb-main-main/
PHASE4_STATUS.md

# Preview directories
Web/preview/
public/preview/
.wrangler/

# CLI scratch — the Supabase CLI writes its resolved version here on every
# invocation, and a linked project ref would land here too.
supabase/.temp/

# generated patch artifacts
.backup/
DutaIntegra-*Patch*/
DutaIntegra-*-Patch*.zip

# Root-level shell-typo artifacts. `npm_config_X= npm run build:web` and
# `tsc -b` at the prompt (rather than inside a package.json script) create
# zero-length files named after the argument the shell misparsed. The build:web
# script already prefixes npm_config_allow_scripts= *inside* the npm script;
# a copy-paste of that line to the shell is what drops these files.
/tsc
/npm_config_*
/*@*.*.*
